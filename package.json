{
  "name": "avie-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:all": "npm test && npm --prefix terrain-ring test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "format:check": "prettier --check \"packages/**/*.ts\" package.json tsconfig.json vitest.config.ts eslint.config.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
